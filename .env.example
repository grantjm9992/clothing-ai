# Clothing AI - Root Environment Configuration
# Copy this to .env and fill in your values

# Environment
ENVIRONMENT=development

# Backend API
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# AI Service
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clothing_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# MinIO (Local S3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=clothing-ai

# AWS (Production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
