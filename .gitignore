# Root .gitignore for Clothing AI monorepo

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/

# Build outputs
dist/
build/
out/

# Docker
docker-compose.override.yml

# Temporary files
tmp/
temp/
*.tmp

# Backups
*.bak
*.backup
